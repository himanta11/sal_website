{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/apsc-banking",
      "destination": "/apsc-coaching.html",
      "permanent": true
    },
    {
      "source": "/apsc-banking/",
      "destination": "/apsc-coaching.html",
      "permanent": true
    },
    {
      "source": "/new-batches-apsc-banking",
      "destination": "/apsc-coaching.html",
      "permanent": true
    },
    {
      "source": "/new-batches-apsc-banking/",
      "destination": "/apsc-coaching.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/courses/apsc",
      "destination": "/apsc-coaching.html"
    },
    {
      "source": "/courses/apsc/",
      "destination": "/apsc-coaching.html"
    },
    {
      "source": "/courses/adre",
      "destination": "/adre-coaching.html"
    },
    {
      "source": "/courses/adre/",
      "destination": "/adre-coaching.html"
    },
    {
      "source": "/courses/ssc",
      "destination": "/ssc-coaching.html"
    },
    {
      "source": "/courses/ssc/",
      "destination": "/ssc-coaching.html"
    },
    {
      "source": "/courses/banking",
      "destination": "/banking-coaching.html"
    },
    {
      "source": "/courses/banking/",
      "destination": "/banking-coaching.html"
    },
    {
      "source": "/courses/rrb",
      "destination": "/rrb-railways-coaching.html"
    },
    {
      "source": "/courses/rrb/",
      "destination": "/rrb-railways-coaching.html"
    },
    {
      "source": "/courses/railways",
      "destination": "/rrb-railways-coaching.html"
    },
    {
      "source": "/courses/railways/",
      "destination": "/rrb-railways-coaching.html"
    },
    {
      "source": "/courses/other",
      "destination": "/rrb-railways-coaching.html"
    },
    {
      "source": "/courses/other/",
      "destination": "/rrb-railways-coaching.html"
    },
    {
      "source": "/courses/tet",
      "destination": "/tet-coaching.html"
    },
    {
      "source": "/courses/tet/",
      "destination": "/tet-coaching.html"
    },
    {
      "source": "/courses/ugc-net",
      "destination": "/ugc-net-coaching.html"
    },
    {
      "source": "/courses/ugc-net/",
      "destination": "/ugc-net-coaching.html"
    },
    {
      "source": "/courses/computer",
      "destination": "/computer-courses.html"
    },
    {
      "source": "/courses/computer/",
      "destination": "/computer-courses.html"
    },
    {
      "source": "/courses",
      "destination": "/courses.html"
    },
    {
      "source": "/courses/",
      "destination": "/courses.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/:slug.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
